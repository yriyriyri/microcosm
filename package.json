{
  "name": "microcosm",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @microcosm/web",
    "build": "npm run build --workspace @microcosm/web && npm run build --workspace @microcosm/api",
    "start": "npm run start --workspace @microcosm/web",
    "dev:web": "npm run dev --workspace @microcosm/web",
    "build:web": "npm run build --workspace @microcosm/web",
    "start:web": "npm run start --workspace @microcosm/web",
    "dev:api": "npm run dev --workspace @microcosm/api",
    "build:api": "npm run build --workspace @microcosm/api",
    "start:api": "npm run start --workspace @microcosm/api"
  },
  "dependencies": {
    "axios": "^1.13.6",
    "jszip": "^3.10.1",
    "next": "16.1.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "three": "^0.182.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.182.0",
    "typescript": "^5"
  }
}
