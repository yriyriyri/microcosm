{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "commonjs",
    "moduleResolution": "node",
    "rootDir": "../..",
    "outDir": "dist",
    "allowJs": false,
    "noEmit": false,
    "declaration": false,
    "baseUrl": "."
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "../../packages/voxel-core/src/**/*.ts"
  ],
  "exclude": ["dist", "node_modules"]
}
